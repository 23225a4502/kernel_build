# AnyKernel3 source (for the flashable zip)
ANYKERNEL_SOURCE=https://github.com/osm0sis/AnyKernel3
ANYKERNEL_SOURCE_BRANCH=master

# Kernel source (Your info)
KERNEL_SOURCE=https://github.com/MotorolaMobilityLLC/kernel-msm
KERNEL_SOURCE_BRANCH=MMI-V1UW35H.63-14-6

# Defconfig (This is correct!)
KERNEL_CONFIG=gki_defconfig

# --- NEW LINES ---
# Specify a stable Google Clang toolchain
CLANG_SOURCE=https://android.googlesource.com/platform/prebuilts/clang/host/linux-x86
CLANG_SOURCE_BRANCH=android13-release

# Build arguments (leave empty)
BUILD_ARGS=""
